{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PomodoroSettings": {
    "MinutesPerPomodoro": 25,
    "MinutesPerShortBreak": 5,
    "MinutesPerLongBreak": 15,
    "PomodorosBeforeLongBreak": 4
  },
  "EmailSettings": {
    "FromEmail": "Simon@CodeBySimon.com",
    "FromName": "Simon Adrell"
  },
  "UserDbSettings": {
    "DatabaseName": "UserContainer",
    "ContainerName": "Users",
    "Setup": true
  },
  "SettingsDbSettings": {
    "DatabaseName": "Settings",
    "ContainerName": "Settings",
    "Setup": false
  },
  "redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "Pomodoro:",
    "TimerCache": {
      "Namespace": "Timer",
      "SlidingExpirationMinutes": 20
    },
    "SettingsCache": {
      "Namespace": "Settings",
      "SlidingExpirationMinutes": 20
    }
  }
}